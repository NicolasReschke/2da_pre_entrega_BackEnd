# Server configuration
PORT=8080
MONGODB_URL=mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.i8k1dis.mongodb.net/ecommerce2?retryWrites=true&w=majority&appName=Cluster0
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here
NODE_ENV=production

# Nodemailer configuration
EMAIL_USER_NODEMAILER=your-email@example.com
EMAIL_PASS_NODEMAILER=your-email-password-here

# Twilio configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=your-twilio-phone-number-here

# DAO type
DAO_TYPE=mongo

# GitHub OAuth configuration for Production (localhost)
GITHUB_CLIENT_ID_PRODUCTION=your-github-client-id-production
GITHUB_CLIENT_SECRET_PRODUCTION=your-github-client-secret-production
GITHUB_CALLBACK_URL_PRODUCTION=http://localhost:8080/auth/github/callback

# GitHub OAuth configuration for Development (Railway)
GITHUB_CLIENT_ID_DEVELOPMENT=your-github-client-id-development
GITHUB_CLIENT_SECRET_DEVELOPMENT=your-github-client-secret-development
GITHUB_CALLBACK_URL_DEVELOPMENT=https://your-railway-app-url/auth/github/callback

# Google OAuth configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL_PRODUCTION=http://localhost:8080/auth/google/callback
GOOGLE_CALLBACK_URL_DEVELOPMENT=https://your-railway-app-url/auth/google/callback

# Admin credentials
ADMIN_EMAIL=your-admin-email-here
ADMIN_PASSWORD=your-admin-password-here

# Stripe configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
